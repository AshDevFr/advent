# Plaintext puzzle content must never be committed. Inside day and final
# folders everything is ignored by default and only the sealed output and the
# encrypted source copy are allowed, so a new kind of plaintext file is
# ignored without anyone having to add a rule.
events/*/day*/*
!events/*/day*/sealed.json
!events/*/day*/source.age
events/*/final/*
!events/*/final/sealed.json
!events/*/final/source.age
!events/*/final/reward-*.bin

# Private keys
editors.key

# Build output (deployed straight from CI, never committed)
dist/

# Local server data and secrets (company edition)
data/
.env

# The engine binary, if a release archive is unpacked here, and a preview
# written with `advent preview --out .preview` (it holds unreleased days)
/advent
/advent.exe
.preview/

.DS_Store
